{
    "name": "drupal/apigee_edge",
    "license": "GPL-2.0-or-later",
    "type": "drupal-module",
    "description": "Apigee for Drupal.",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-json": "*",
        "apigee/apigee-client-php": "~4.1.0",
        "drupal/core": "^11.3",
        "drupal/entity": "^1.0",
        "drupal/key": "^1.8",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "require-dev": {
        "apigee/apigee-mock-client-php": "^1.1.4",
        "drupal/drupal-extension": "~5",
        "cweagans/composer-patches": "^1.6",
        "drupal/core-dev": "^11.3",
        "drush/drush": "^13.3",
        "mglaman/drupal-check": "1.5",
        "phpmd/phpmd": "^2.8.2",
        "phpmetrics/phpmetrics": "^2.5",
        "phpstan/phpstan": "^1.12"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "symfony/runtime": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "drush": {
            "services": {
                "drush.services.yml": "^13"
            }
        }
    },
    "scripts": {
        "lint": "vendor/bin/phpcs --standard=phpcs.xml.dist . -p -s -n --colors --ignore=vendor/",
        "format": "vendor/bin/phpcbf --standard=phpcs.xml.dist . -s --colors --ignore=vendor/",
        "phpstan": "vendor/bin/phpstan analyze src --level=1",
        "test": "vendor/bin/phpunit -c ../devportal-kickstart-project-composer/web/core/phpunit.xml.dist tests/src/Unit"
    }
}
